# Redis (Railway-managed) — Celery broker and result backend
REDIS_URL=redis://default:password@redis.railway.internal:6379

# Canonical Supabase database inputs. The worker derives its transaction-pooler
# URL in memory and strips Prisma-only query parameters before calling psycopg.
# Confirm the pooler host in the project's Supabase Connect panel; set the
# optional override only when it differs from the default AP Southeast host.
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_DB_PASSWORD=replace-with-database-password
# SUPABASE_DB_POOLER_HOST=aws-1-ap-southeast-2.pooler.supabase.com

# Shared secret for worker -> Next.js internal job calls
# (app/api/internal/jobs/*). Must match INTERNAL_JOBS_SECRET in Vercel.
INTERNAL_JOBS_SECRET=

# Base URL of the deployed Next.js app (for internal job calls)
PAIDSOON_APP_URL=https://app.paidsoon.example

# Only needed if PAIDSOON_APP_URL points at a Vercel deployment with
# Deployment Protection (Vercel Authentication) enabled — e.g. a protected
# dev/preview domain. Generate in Vercel: Project Settings -> Deployment
# Protection -> Protection Bypass for Automation -> copy the generated
# secret. Without it every internal-jobs call 401s with a Vercel SSO page
# instead of reaching the route handler. Leave unset for unprotected domains.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Shared secret for Next.js -> worker "trigger now" HTTP calls
# (worker/paidsoon_worker/http_server.py). Must match WORKER_TRIGGER_SECRET
# in Vercel.
WORKER_TRIGGER_SECRET=

# Identity of this Celery Beat instance, for heartbeat rows (keep default
# unless running more than one named dispatcher).
DISPATCHER_NAME=celery-beat

# Cadence of the write-heartbeat Beat entry only (design.md: 1-5 minutes),
# in seconds — this is the "is Celery Beat alive" signal the Vercel watchdog
# checks. Also supplies the default for each DISPATCH_*_INTERVAL_SECONDS var
# below when that var is unset. Must be set to the SAME value on the Vercel
# project (see docs/runbooks/README.md env matrix) so the watchdog's
# staleness threshold stays proportional to the real heartbeat cadence.
DISPATCH_INTERVAL_SECONDS=120

# Per-task dispatch intervals, in seconds — each defaults to
# DISPATCH_INTERVAL_SECONDS above when unset, so a deployment that only sets
# that one var keeps every task on the same shared cadence. Set any of these
# individually to tune one workflow's cadence without affecting the others.
DISPATCH_REMINDER_INTERVAL_SECONDS=
DISPATCH_ACCOUNTING_SYNC_INTERVAL_SECONDS=
DISPATCH_CATCHUP_SNOOZE_INTERVAL_SECONDS=
DISPATCH_PROMISE_ARRANGEMENT_INTERVAL_SECONDS=
# Floored at 300s regardless of this value (never runs more than every 5 min).
DISPATCH_RECOVERY_SWEEP_INTERVAL_SECONDS=

# A claim left in `processing` longer than this (seconds) is assumed to be
# an abandoned/crashed task and is reclaimed by the recovery sweep.
STALE_PROCESSING_THRESHOLD_SECONDS=600

# Per-task retry policy for Xero/MYOB/Resend failures.
MAX_TASK_RETRIES=5
RETRY_BACKOFF_BASE_SECONDS=30
