// PaidSoon — Prisma Schema
// Connection managed via prisma.config.ts (Prisma 6)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// User Profiles
// ---------------------------------------------------------------------------

model UserProfile {
  id                           String    @id @default(cuid())
  userId                       String    @unique // maps to auth.users.id in Supabase
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?   @map("stripe_subscription_id")
  subscriptionCurrentPeriodEnd DateTime? @map("subscription_current_period_end")
  pendingDowngradeTier         String?   @map("pending_downgrade_tier")
  stripeScheduleId             String?   @map("stripe_schedule_id")
  subscriptionTier             String    @default("free") // 'free' | 'pro'
  subscriptionStatus           String    @default("active") // 'active' | 'trialing' | 'cancelled' | 'past_due'
  trialEndsAt                  DateTime? @map("trial_ends_at")
  onboardingCompletedAt        DateTime? @map("onboarding_completed_at")
  displayName                  String?   @map("display_name")
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  invoiceConnections    InvoiceConnection[]
  schedule              Schedule?
  emailSettings         EmailSettings?
  trackedInvoices       TrackedInvoice[]
  emailTemplates        EmailTemplate[]
  aiUsageLogs           AiUsageLog[]
  accountingConnections AccountingConnection[]

  @@map("user_profiles")
}

// ---------------------------------------------------------------------------
// Invoice Connections (provider-agnostic adapter hook)
// ---------------------------------------------------------------------------

model InvoiceConnection {
  id                     String   @id @default(cuid())
  userId                 String
  provider               String   @default("stripe") // 'stripe' | future providers
  stripeConnectAccountId String? // encrypted at app layer
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  userProfile     UserProfile      @relation(fields: [userId], references: [userId])
  trackedInvoices TrackedInvoice[]

  @@map("invoice_connections")
}

// ---------------------------------------------------------------------------
// Follow-up Schedule
// ---------------------------------------------------------------------------

model Schedule {
  id                 String   @id @default(cuid())
  userId             String   @unique
  email1DaysAfterDue Int      @default(3)
  email2DaysAfterDue Int      @default(10)
  email3DaysAfterDue Int      @default(21)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userId], references: [userId])

  @@map("schedules")
}

// ---------------------------------------------------------------------------
// Email Settings (Pro tier)
// ---------------------------------------------------------------------------

model EmailSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  fromEmail      String? // null = use system domain
  fromName       String?
  replyTo        String?
  resendVerified Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userId], references: [userId])

  @@map("email_settings")
}

// ---------------------------------------------------------------------------
// Tracked Invoices
// ---------------------------------------------------------------------------

model TrackedInvoice {
  id                  String    @id @default(cuid())
  userId              String
  invoiceConnectionId String
  externalId          String // e.g. Stripe invoice ID
  provider            String    @default("stripe")
  clientEmail         String
  clientName          String
  amountDue           Int // in smallest currency unit (cents)
  currency            String    @default("usd")
  dueDate             DateTime
  status              String    @default("pending")
  // 'pending' | 'paid' | 'paused' | 'snoozed' | 'sequence_complete' | 'manually_resolved'
  currentStage        Int       @default(0) // 0=not started, 1=email1 sent, 2=email2 sent, 3=email3 sent
  nextEmailAt         DateTime?
  snoozedUntil        DateTime?
  providerMetadata    Json?     @map("provider_metadata") // provider-specific fields, not part of core model
  p2pToken            String?   @unique @map("p2p_token") // generated for Business+ users; client uses to submit a promise to pay
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userProfile            UserProfile             @relation(fields: [userId], references: [userId])
  invoiceConnection      InvoiceConnection       @relation(fields: [invoiceConnectionId], references: [id])
  emailLogs              EmailLog[]
  providerInvoiceMapping ProviderInvoiceMapping?
  promisesToPay          PromiseToPay[]

  @@unique([externalId, provider, userId])
  @@map("tracked_invoices")
}

// ---------------------------------------------------------------------------
// Promise to Pay
// ---------------------------------------------------------------------------

model PromiseToPay {
  id               String @id @default(cuid())
  trackedInvoiceId String @map("tracked_invoice_id")
  userId           String @map("user_id") // for RLS scoping

  promisedPayBy  DateTime @map("promised_pay_by")
  promisedAmount Int?     @map("promised_amount") // null = full invoice amount; in cents
  clientNotes    String?  @map("client_notes") // optional free-text note from client

  status           String    @default("active") // 'active' | 'kept' | 'broken' | 'superseded'
  breachNotifiedAt DateTime? @map("breach_notified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trackedInvoice TrackedInvoice @relation(fields: [trackedInvoiceId], references: [id])

  @@index([trackedInvoiceId, createdAt])
  @@index([status, promisedPayBy])
  @@map("promise_to_pay")
}

// ---------------------------------------------------------------------------
// Email Logs
// ---------------------------------------------------------------------------

model EmailLog {
  id               String   @id @default(cuid())
  trackedInvoiceId String
  stage            Int // 1, 2, or 3
  sentAt           DateTime @default(now())
  resendMessageId  String?
  fromAddress      String
  subject          String

  trackedInvoice TrackedInvoice @relation(fields: [trackedInvoiceId], references: [id])

  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// AI Usage Logs (Small Business tier — ai_rewrite feature)
// ---------------------------------------------------------------------------

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  model            String // e.g. "gpt-4o-mini"
  feature          String // e.g. "ai_rewrite"
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  estimatedCostUsd Decimal  @map("estimated_cost_usd") @db.Decimal(12, 8)
  createdAt        DateTime @default(now()) @map("created_at")

  userProfile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Email Templates (Small Business tier)
// ---------------------------------------------------------------------------

model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String
  stage     Int // 1, 2, or 3
  subject   String
  htmlBody  String
  textBody  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userId], references: [userId])

  @@unique([userId, stage])
  @@map("email_templates")
}

// ---------------------------------------------------------------------------
// Accounting Connections (Xero / MYOB)
// ---------------------------------------------------------------------------

model AccountingConnection {
  id                    String    @id @default(cuid())
  userId                String
  provider              String // 'xero' | 'myob'
  organisationId        String    @map("organisation_id") // tenantId (Xero) or businessId/cf_uri (MYOB)
  organisationName      String    @map("organisation_name")
  encryptedAccessToken  String    @map("encrypted_access_token")
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime  @map("token_expires_at")
  scopes                String // space-separated scope list as requested
  status                String    @default("active") // 'active' | 'disconnected' | 'revoked' | 'error'
  lastSyncedAt          DateTime? @map("last_synced_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  userProfile             UserProfile              @relation(fields: [userId], references: [userId])
  syncRuns                AccountingSyncRun[]
  providerInvoiceMappings ProviderInvoiceMapping[]
  providerContactMappings ProviderContactMapping[]

  @@unique([userId, provider, organisationId])
  @@map("accounting_connections")
}

// ---------------------------------------------------------------------------
// Accounting Sync Runs
// ---------------------------------------------------------------------------

model AccountingSyncRun {
  id                     String    @id @default(cuid())
  accountingConnectionId String    @map("accounting_connection_id")
  provider               String // 'xero' | 'myob'
  userId                 String
  startedAt              DateTime  @default(now()) @map("started_at")
  completedAt            DateTime? @map("completed_at")
  status                 String    @default("running") // 'running' | 'success' | 'partial' | 'failed'
  invoicesCreated        Int       @default(0) @map("invoices_created")
  invoicesUpdated        Int       @default(0) @map("invoices_updated")
  invoicesSkipped        Int       @default(0) @map("invoices_skipped")
  errorMessage           String?   @map("error_message") // sanitised, no PII or tokens

  accountingConnection AccountingConnection @relation(fields: [accountingConnectionId], references: [id])

  @@index([accountingConnectionId, startedAt])
  @@index([userId, startedAt])
  @@map("accounting_sync_runs")
}

// ---------------------------------------------------------------------------
// Provider Invoice Mappings
// ---------------------------------------------------------------------------

model ProviderInvoiceMapping {
  id                     String    @id @default(cuid())
  trackedInvoiceId       String    @unique @map("tracked_invoice_id")
  accountingConnectionId String    @map("accounting_connection_id")
  providerInvoiceId      String    @map("provider_invoice_id") // e.g. Xero InvoiceID or MYOB UID
  providerUpdatedAt      DateTime? @map("provider_updated_at") // used for incremental sync
  providerMetadata       Json?     @map("provider_metadata") // provider-specific fields
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  trackedInvoice       TrackedInvoice       @relation(fields: [trackedInvoiceId], references: [id])
  accountingConnection AccountingConnection @relation(fields: [accountingConnectionId], references: [id])

  @@unique([providerInvoiceId, accountingConnectionId])
  @@map("provider_invoice_mappings")
}

// ---------------------------------------------------------------------------
// Provider Contact Mappings
// ---------------------------------------------------------------------------

model ProviderContactMapping {
  id                     String   @id @default(cuid())
  accountingConnectionId String   @map("accounting_connection_id")
  providerContactId      String   @map("provider_contact_id") // e.g. Xero ContactID or MYOB Customer UID
  contactName            String?  @map("contact_name")
  contactEmail           String?  @map("contact_email")
  providerMetadata       Json?    @map("provider_metadata")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  accountingConnection AccountingConnection @relation(fields: [accountingConnectionId], references: [id])

  @@unique([providerContactId, accountingConnectionId])
  @@map("provider_contact_mappings")
}

// ---------------------------------------------------------------------------
// OAuth States (CSRF nonce for accounting OAuth callbacks)
// ---------------------------------------------------------------------------

model OauthState {
  id        String   @id @default(cuid())
  userId    String
  provider  String // 'xero' | 'myob'
  nonce     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([nonce])
  @@index([expiresAt])
  @@map("oauth_states")
}

// ---------------------------------------------------------------------------
// Platform Admin Models
// ---------------------------------------------------------------------------

enum PlatformRoleType {
  platform_owner
  platform_admin
  platform_support
}

enum PlatformRoleStatus {
  active
  disabled
}

enum AdminDeviceStatus {
  pending
  active
  revoked
  expired
}

enum AdminAuditAction {
  admin_challenge_created
  admin_challenge_verified
  admin_challenge_failed
  admin_session_started
  admin_session_expired
  admin_session_revoked
  device_enrolled
  device_revoked
  staff_invited
  role_assigned
  role_changed
  staff_disabled
  tenant_viewed
  impersonation_started
  impersonation_ended
  impersonation_destructive_action
  subscription_changed
  integration_action
  email_job_retried
  email_job_paused
  email_job_resumed
  system_setting_changed
  admin_tenant_action
  customer_search
  impersonate_start
  impersonate_end
  impersonate_timeout
  impersonate_conflict
  update_schedule
  pause_invoices
  resume_invoices
  trigger_email
  mark_invoice_paid
}

enum StaffInvitationStatus {
  pending
  accepted
  expired
  revoked
}

model PlatformRole {
  id        String             @id @default(cuid())
  userId    String             @unique @map("user_id")
  role      PlatformRoleType
  status    PlatformRoleStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at")
  createdBy String             @map("created_by")
  updatedAt DateTime           @updatedAt @map("updated_at")

  adminDevices    AdminDevice[]
  adminSessions   AdminSession[]
  adminChallenges AdminChallenge[]

  @@map("platform_roles")
}

model AdminDevice {
  id                   String            @id @default(cuid())
  adminUserId          String            @map("admin_user_id")
  label                String
  publicKeyBytes       Bytes             @map("public_key_bytes")
  publicKeyFingerprint String            @unique @map("public_key_fingerprint")
  keyType              String            @default("ssh-ed25519") @map("key_type")
  status               AdminDeviceStatus @default(pending)
  createdAt            DateTime          @default(now()) @map("created_at")
  createdBy            String            @map("created_by")
  revokedAt            DateTime?         @map("revoked_at")
  revokedBy            String?           @map("revoked_by")
  lastVerifiedAt       DateTime?         @map("last_verified_at")
  lastUsedIp           String?           @map("last_used_ip")
  lastUserAgent        String?           @map("last_user_agent")

  platformRole  PlatformRole   @relation(fields: [adminUserId], references: [userId])
  adminSessions AdminSession[]

  @@index([adminUserId])
  @@map("admin_devices")
}

model AdminChallenge {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  nonce     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  ipAddress String    @map("ip_address")
  userAgent String    @map("user_agent")

  adminSession AdminSession?
  platformRole PlatformRole  @relation(fields: [userId], references: [userId])

  @@index([userId, createdAt])
  @@map("admin_challenges")
}

model AdminSession {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  adminDeviceId        String    @map("admin_device_id")
  adminChallengeId     String    @unique @map("admin_challenge_id")
  sessionToken         String    @unique @map("session_token")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  impersonatedTenantId String?   @map("impersonated_tenant_id")
  impersonatedUserId   String?   @map("impersonated_user_id") // customer being impersonated (support console)
  notifyCustomer       Boolean   @default(false) @map("notify_customer") // whether to notify customer after impersonation
  createdAt            DateTime  @default(now()) @map("created_at")
  startedAt            DateTime  @default(now()) @map("started_at") // when support session started
  endedAt              DateTime? @map("ended_at") // when support session ended
  duration             Int?      @map("duration") // seconds (calculated on end)
  actionCount          Int       @default(0) @map("action_count") // count of linked audit events
  ipAddress            String    @map("ip_address")
  userAgent            String    @map("user_agent")

  platformRole       PlatformRole       @relation(fields: [userId], references: [userId])
  adminDevice        AdminDevice        @relation(fields: [adminDeviceId], references: [id])
  adminChallenge     AdminChallenge     @relation(fields: [adminChallengeId], references: [id])
  adminAuditEvents   AdminAuditEvent[] // link to audit events created during this session

  @@index([userId, expiresAt])
  @@index([impersonatedUserId, startedAt])
  @@map("admin_sessions")
}

model AdminAuditEvent {
  id                     String           @id @default(cuid())
  actorUserId            String           @map("actor_user_id")
  actorEmail             String           @map("actor_email")
  platformRole           PlatformRoleType @map("platform_role")
  adminDeviceId          String?          @map("admin_device_id")
  adminDeviceFingerprint String?          @map("admin_device_fingerprint")
  adminSessionId         String?          @map("admin_session_id") // link to impersonation session if event occurred during one
  action                 AdminAuditAction
  targetType             String?          @map("target_type")
  targetId               String?          @map("target_id")
  targetUserId           String?          @map("target_user_id") // customer being acted upon (support console)
  resourceId             String?          @map("resource_id") // specific resource (invoiceId, scheduleId, etc.)
  tenantId               String?          @map("tenant_id")
  ipAddress              String           @map("ip_address")
  userAgent              String           @map("user_agent")
  requestId              String           @map("request_id")
  success                Boolean
  reason                 String?
  metadata               Json?
  details                Json?            // context-specific data (old/new values, counts, etc.)
  createdAt              DateTime         @default(now()) @map("created_at")

  adminSession AdminSession? @relation(fields: [adminSessionId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([tenantId, createdAt])
  @@index([adminSessionId])
  @@index([targetUserId, createdAt])
  @@map("admin_audit_events")
}

model StaffInvitation {
  id               String                @id @default(cuid())
  email            String
  role             PlatformRoleType
  token            String                @unique
  status           StaffInvitationStatus @default(pending)
  createdAt        DateTime              @default(now()) @map("created_at")
  createdBy        String                @map("created_by")
  expiresAt        DateTime              @map("expires_at")
  acceptedAt       DateTime?             @map("accepted_at")
  acceptedByUserId String?               @map("accepted_by_user_id")

  @@index([token])
  @@index([email, status])
  @@map("staff_invitations")
}

// ---------------------------------------------------------------------------
// Audit Log Retention (Archival tracking for 7-year compliance)
// ---------------------------------------------------------------------------

model AuditRetentionLog {
  id               String    @id @default(cuid())
  timestamp        DateTime  @default(now())
  recordsArchived  Int       @map("records_archived")
  s3Path           String?   @map("s3_path")
  success          Boolean   @default(true)
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([timestamp])
  @@index([success])
  @@map("audit_retention_logs")
}
