// PaidSoon — Prisma Schema
// Connection managed via prisma.config.ts (Prisma 6)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// User Profiles
// ---------------------------------------------------------------------------

model UserProfile {
  id                             String    @id @default(cuid())
  userId                         String    @unique // maps to auth.users.id in Supabase
  stripeCustomerId               String?   @unique
  stripeSubscriptionId           String?   @map("stripe_subscription_id")
  subscriptionCurrentPeriodStart DateTime? @map("subscription_current_period_start")
  subscriptionCurrentPeriodEnd   DateTime? @map("subscription_current_period_end")
  subscriptionCancelAt           DateTime? @map("subscription_cancel_at")
  pendingDowngradeTier           String?   @map("pending_downgrade_tier")
  stripeScheduleId               String?   @map("stripe_schedule_id")
  subscriptionTier               String    @default("starter") // 'starter' | 'solo' | 'small_business' | 'accountant_partner'
  subscriptionStatus             String    @default("active") // 'active' | 'trialing' | 'cancelled' | 'past_due'
  trialEndsAt                    DateTime? @map("trial_ends_at")
  onboardingCompletedAt          DateTime? @map("onboarding_completed_at")
  displayName                    String?   @map("display_name")
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  invoiceConnections           InvoiceConnection[]
  schedule                     Schedule?
  emailSettings                EmailSettings?
  trackedInvoices              TrackedInvoice[]
  financialContacts            FinancialContact[]
  financialInvoices            FinancialInvoice[]
  financialPayments            FinancialPayment[]
  arrangements                 Arrangement[]
  customers                    Customer[]
  promiseEscalationPolicy      PromiseEscalationPolicy?
  emailTemplates               EmailTemplate[]
  aiUsageLogs                  AiUsageLog[]
  accountingConnections        AccountingConnection[]
  importedBills                ImportedBill[]
  importedBankTransactions     ImportedBankTransaction[]
  supplierProfiles             SupplierProfile[]
  spendInsights                SpendInsight[]
  cashForecastSnapshots        CashForecastSnapshot[]
  invoiceImportBatches         InvoiceImportBatch[]
  invoiceImportMappingProfiles InvoiceImportMappingProfile[]
  spendImportBatches           SpendImportBatch[]

  @@map("user_profiles")
}

// ---------------------------------------------------------------------------
// Invoice Import Batch + Mapping Models
// ---------------------------------------------------------------------------

model InvoiceImportBatch {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  fileName        String    @map("file_name")
  fileType        String    @map("file_type")
  fileSizeBytes   Int       @map("file_size_bytes")
  contentHash     String    @map("content_hash")
  schemaVersion   String    @map("schema_version")
  worksheetName   String?   @map("worksheet_name")
  dateFormat      String?   @map("date_format")
  numberFormat    String?   @map("number_format")
  defaultCurrency String?   @map("default_currency")
  duplicateMode   String    @default("skip_existing") @map("duplicate_mode")
  mapping         Json?     @map("mapping")
  status          String    @default("uploaded")
  failureReason   String?   @map("failure_reason")
  rowsTotal       Int       @default(0) @map("rows_total")
  rowsValid       Int       @default(0) @map("rows_valid")
  rowsWarning     Int       @default(0) @map("rows_warning")
  rowsSkipped     Int       @default(0) @map("rows_skipped")
  rowsFailed      Int       @default(0) @map("rows_failed")
  createdAt       DateTime  @default(now()) @map("created_at")
  validatedAt     DateTime? @map("validated_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  userProfile UserProfile                  @relation(fields: [userId], references: [userId])
  mappings    InvoiceImportColumnMapping[]
  stagingRows InvoiceImportStagingRow[]
  errors      InvoiceImportError[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("invoice_import_batches")
}

model InvoiceImportColumnMapping {
  id           String   @id @default(cuid())
  batchId      String   @map("batch_id")
  sourceColumn String   @map("source_column")
  targetField  String   @map("target_field")
  suggested    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  batch InvoiceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, sourceColumn])
  @@index([batchId, targetField])
  @@map("invoice_import_column_mappings")
}

model InvoiceImportStagingRow {
  id               String   @id @default(cuid())
  batchId          String   @map("batch_id")
  rowNumber        Int      @map("row_number")
  raw              Json
  normalized       Json?
  status           String   @default("pending")
  validationErrors Json?    @map("validation_errors")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  batch InvoiceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@index([batchId, rowNumber])
  @@map("invoice_import_staging_rows")
}

model InvoiceImportError {
  id            String   @id @default(cuid())
  batchId       String   @map("batch_id")
  rowNumber     Int?     @map("row_number")
  invoiceNumber String?  @map("invoice_number")
  fieldName     String?  @map("field_name")
  errorCode     String   @map("error_code")
  message       String
  severity      String   @default("error")
  createdAt     DateTime @default(now()) @map("created_at")

  batch InvoiceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, severity])
  @@index([batchId, errorCode])
  @@map("invoice_import_errors")
}

model InvoiceImportMappingProfile {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  schemaVersion String   @map("schema_version")
  mapping       Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  userProfile UserProfile @relation(fields: [userId], references: [userId])

  @@unique([userId, name])
  @@index([userId, updatedAt])
  @@map("invoice_import_mapping_profiles")
}

// ---------------------------------------------------------------------------
// Invoice Connections (provider-agnostic adapter hook)
// ---------------------------------------------------------------------------

model InvoiceConnection {
  id                     String   @id @default(cuid())
  userId                 String
  provider               String   @default("stripe") // 'stripe' | future providers
  stripeConnectAccountId String? // encrypted at app layer
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  userProfile     UserProfile      @relation(fields: [userId], references: [userId])
  trackedInvoices TrackedInvoice[]

  @@map("invoice_connections")
}

// ---------------------------------------------------------------------------
// Follow-up Schedule
// ---------------------------------------------------------------------------

model Schedule {
  id                 String   @id @default(cuid())
  userId             String   @unique
  email1DaysAfterDue Int      @default(3)
  email2DaysAfterDue Int      @default(10)
  email3DaysAfterDue Int      @default(21)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userId], references: [userId])

  @@map("schedules")
}

// ---------------------------------------------------------------------------
// Email Settings (Pro tier)
// ---------------------------------------------------------------------------

model EmailSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  fromEmail      String? // null = use system domain
  fromName       String?
  replyTo        String?
  resendVerified Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userId], references: [userId])

  @@map("email_settings")
}

// ---------------------------------------------------------------------------
// Canonical Financial Data (provider-neutral receivables layer)
// Every ingestion path (Xero, MYOB, Stripe, CSV/XLSX) writes here; product
// features read from here. See openspec/changes/canonical-financial-data-model.
// ---------------------------------------------------------------------------

model FinancialContact {
  id                     String    @id @default(cuid())
  userId                 String    @map("user_id")
  sourceSystem           String    @map("source_system") // 'xero' | 'myob' | 'stripe' | 'csv'
  sourceId               String    @map("source_id") // provider contact ID; synthetic "email:<lower>" for stripe/csv
  sourceUpdatedAt        DateTime? @map("source_updated_at")
  syncedAt               DateTime  @default(now()) @map("synced_at")
  accountingConnectionId String?   @map("accounting_connection_id") // null for stripe/csv sources
  name                   String
  email                  String?
  emailLower             String?   @map("email_lower") // lowercased email; Postgres unique constraints don't case-fold
  rawSourceData          Json?     @map("raw_source_data")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  userProfile          UserProfile           @relation(fields: [userId], references: [userId])
  accountingConnection AccountingConnection? @relation(fields: [accountingConnectionId], references: [id])
  financialInvoices    FinancialInvoice[]
  customers            Customer[]

  @@unique([userId, sourceSystem, sourceId])
  @@unique([userId, emailLower])
  @@index([userId, sourceSystem])
  @@map("financial_contacts")
}

model FinancialInvoice {
  id                     String    @id @default(cuid())
  userId                 String    @map("user_id")
  sourceSystem           String    @map("source_system") // 'xero' | 'myob' | 'stripe' | 'csv'
  sourceId               String    @map("source_id") // provider invoice ID / import-derived external ID
  sourceUpdatedAt        DateTime? @map("source_updated_at")
  syncedAt               DateTime  @default(now()) @map("synced_at")
  accountingConnectionId String?   @map("accounting_connection_id") // null for stripe/csv sources
  contactId              String?   @map("contact_id")
  invoiceNumber          String?   @map("invoice_number")
  amountDueCents         Int       @map("amount_due_cents") // the invoice's fixed original total in cents — NOT the current outstanding balance (see lib/invoices/payments.ts#computeOutstanding)
  currency               String // ISO 4217, lowercase; ALWAYS from source — no default (design D3)
  dueDate                DateTime  @map("due_date")
  issueDate              DateTime? @map("issue_date")
  paymentUrl             String?   @map("payment_url")
  rawSourceData          Json?     @map("raw_source_data")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  userProfile          UserProfile           @relation(fields: [userId], references: [userId])
  accountingConnection AccountingConnection? @relation(fields: [accountingConnectionId], references: [id])
  contact              FinancialContact?     @relation(fields: [contactId], references: [id])
  trackedInvoice       TrackedInvoice?
  financialPayments    FinancialPayment[]

  @@unique([userId, sourceSystem, sourceId])
  @@index([userId, dueDate])
  @@index([userId, contactId])
  @@map("financial_invoices")
}

model FinancialPayment {
  id                     String    @id @default(cuid())
  userId                 String    @map("user_id")
  sourceSystem           String    @map("source_system")
  sourceId               String    @map("source_id")
  sourceUpdatedAt        DateTime? @map("source_updated_at")
  syncedAt               DateTime  @default(now()) @map("synced_at")
  accountingConnectionId String?   @map("accounting_connection_id")
  financialInvoiceId     String?   @map("financial_invoice_id")
  amountCents            Int       @map("amount_cents")
  currency               String // no default — always from source (design D3)
  paidAt                 DateTime  @map("paid_at")
  rawSourceData          Json?     @map("raw_source_data")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  userProfile          UserProfile           @relation(fields: [userId], references: [userId])
  accountingConnection AccountingConnection? @relation(fields: [accountingConnectionId], references: [id])
  financialInvoice     FinancialInvoice?     @relation(fields: [financialInvoiceId], references: [id])

  @@unique([userId, sourceSystem, sourceId])
  @@index([userId, paidAt])
  @@map("financial_payments")
}

// ---------------------------------------------------------------------------
// Tracked Invoices (chasing workflow state only — invoice facts live on the
// linked FinancialInvoice)
// ---------------------------------------------------------------------------

model TrackedInvoice {
  id                 String   @id @default(cuid())
  userId             String
  financialInvoiceId String   @unique @map("financial_invoice_id")
  invoiceConnectionId String
  customerId          String?
  status              String    @default("pending")
  // 'pending' | 'paid' | 'paused' | 'snoozed' | 'sequence_complete' | 'manually_resolved' | 'disputed'
  currentStage        Int       @default(0) // 0=not started, 1=email1 sent, 2=email2 sent, 3=email3 sent
  nextEmailAt         DateTime?
  snoozedUntil        DateTime?
  firstChasedAt       DateTime? @map("first_chased_at") // set once, when the first reminder is sent; consumes chase-volume allowance
  providerMetadata    Json?     @map("provider_metadata") // chasing-scoped remnants; invoice facts live on FinancialInvoice.rawSourceData
  p2pToken            String?   @unique @map("p2p_token") // generated for Business+ users; client uses to submit a promise to pay
  disputeNote         String?   @map("dispute_note")
  disputeRaisedAt     DateTime? @map("dispute_raised_at")
  disputeResolvedAt   DateTime? @map("dispute_resolved_at")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userProfile          UserProfile                  @relation(fields: [userId], references: [userId])
  financialInvoice     FinancialInvoice             @relation(fields: [financialInvoiceId], references: [id])
  invoiceConnection    InvoiceConnection            @relation(fields: [invoiceConnectionId], references: [id])
  customer             Customer?                    @relation(fields: [customerId], references: [id])
  emailLogs            EmailLog[]
  promisesToPay        PromiseToPay[]
  arrangementCoverages ArrangementInvoiceCoverage[]
  payments             InvoicePayment[]

  @@index([userId, firstChasedAt])
  @@index([customerId])
  @@map("tracked_invoices")
}

// ---------------------------------------------------------------------------
// Invoice Payments (append-only ledger)
// ---------------------------------------------------------------------------

model InvoicePayment {
  id               String   @id @default(cuid())
  trackedInvoiceId String   @map("tracked_invoice_id")
  userId           String   @map("user_id")
  amount           Int // in smallest currency unit (cents); always positive
  currency         String
  source           String // 'manual' | 'import_reconciliation'
  note             String?
  recordedAt       DateTime @default(now()) @map("recorded_at")
  createdAt        DateTime @default(now()) @map("created_at")

  trackedInvoice TrackedInvoice @relation(fields: [trackedInvoiceId], references: [id])

  @@index([trackedInvoiceId])
  @@index([userId])
  @@map("invoice_payments")
}

// ---------------------------------------------------------------------------
// Customers (tenant-scoped debtor directory)
// ---------------------------------------------------------------------------

model Customer {
  id                 String   @id @default(cuid())
  userId             String
  financialContactId String   @map("financial_contact_id") // debtor identity lives on the canonical contact; this row carries chasing preferences only
  neverAutoChase     Boolean  @default(false) @map("never_auto_chase")
  unsubscribed       Boolean  @default(false)
  cadenceOverride    Json?    @map("cadence_override") // { email1DaysAfterDue, email2DaysAfterDue, email3DaysAfterDue }; overrides the tenant's Schedule when present
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  userProfile      UserProfile      @relation(fields: [userId], references: [userId])
  financialContact FinancialContact @relation(fields: [financialContactId], references: [id])
  trackedInvoices  TrackedInvoice[]
  arrangements     Arrangement[]

  @@unique([userId, financialContactId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Arrangement Agreements (freelancer-managed)
// ---------------------------------------------------------------------------

model Arrangement {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  customerId      String?   @map("customer_id")
  debtorEmail     String    @map("debtor_email")
  debtorName      String?   @map("debtor_name")
  arrangementType String    @map("arrangement_type") // 'full_payment' | 'partial_payment' | 'instalment_plan'
  status          String    @default("active") // 'active' | 'broken' | 'fulfilled' | 'expired' | 'cancelled'
  promisedPayBy   DateTime? @map("promised_pay_by")
  agreedAmount    Int?      @map("agreed_amount") // amount in cents; optional for full balance commitments
  currency        String    @default("usd")
  planSchedule    Json?     @map("plan_schedule") // instalment metadata when arrangementType = 'instalment_plan'
  termsNotes      String?   @map("terms_notes")
  expiresAt       DateTime? @map("expires_at")
  breachedAt      DateTime? @map("breached_at")
  fulfilledAt     DateTime? @map("fulfilled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  userProfile UserProfile                  @relation(fields: [userId], references: [userId])
  customer    Customer?                    @relation(fields: [customerId], references: [id])
  coverages   ArrangementInvoiceCoverage[]

  @@unique([id, userId])
  @@unique([id, userId, debtorEmail])
  @@index([userId, status])
  @@index([userId, debtorEmail])
  @@index([customerId])
  @@map("arrangements")
}

model ArrangementInvoiceCoverage {
  id               String   @id @default(cuid())
  arrangementId    String   @map("arrangement_id")
  trackedInvoiceId String   @map("tracked_invoice_id")
  userId           String   @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  arrangement    Arrangement    @relation(fields: [arrangementId, userId], references: [id, userId])
  trackedInvoice TrackedInvoice @relation(fields: [trackedInvoiceId], references: [id])

  @@unique([arrangementId, trackedInvoiceId])
  @@index([trackedInvoiceId])
  @@map("arrangement_invoice_coverages")
}

// ---------------------------------------------------------------------------
// Promise to Pay
// ---------------------------------------------------------------------------

model PromiseToPay {
  id               String @id @default(cuid())
  trackedInvoiceId String @map("tracked_invoice_id")
  userId           String @map("user_id") // for RLS scoping

  promisedPayBy  DateTime @map("promised_pay_by")
  promisedAmount Int?     @map("promised_amount") // null = full invoice amount; in cents
  clientNotes    String?  @map("client_notes") // optional free-text note from client

  status           String    @default("active") // 'active' | 'kept' | 'broken' | 'superseded'
  breachNotifiedAt DateTime? @map("breach_notified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trackedInvoice TrackedInvoice @relation(fields: [trackedInvoiceId], references: [id])

  @@index([trackedInvoiceId, createdAt])
  @@index([status, promisedPayBy])
  @@map("promise_to_pay")
}

model PromiseEscalationPolicy {
  id                      String   @id @default(cuid())
  userId                  String   @unique @map("user_id")
  retryLimit              Int      @default(2) @map("retry_limit")
  escalationThreshold     Int      @default(2) @map("escalation_threshold")
  timingEscalationEnabled Boolean  @default(false) @map("timing_escalation_enabled")
  toneEscalationEnabled   Boolean  @default(false) @map("tone_escalation_enabled")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  userProfile UserProfile @relation(fields: [userId], references: [userId])

  @@map("promise_escalation_policies")
}

// ---------------------------------------------------------------------------
// Email Logs
// ---------------------------------------------------------------------------

model EmailLog {
  id               String   @id @default(cuid())
  trackedInvoiceId String
  stage            Int // 1, 2, or 3
  sentAt           DateTime @default(now())
  resendMessageId  String?
  fromAddress      String
  subject          String
  htmlBody         String?  @map("html_body") // rendered HTML body at send time; null for rows predating this column
  textBody         String?  @map("text_body") // rendered text body at send time; null for rows predating this column
  status           String   @default("sent") // 'sent' | 'delivered' | 'bounced' | 'complained'; updated by the Resend delivery webhook (app/api/webhooks/resend)

  trackedInvoice TrackedInvoice @relation(fields: [trackedInvoiceId], references: [id])

  @@unique([trackedInvoiceId, stage])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Weekly Debtor Summary Deliveries
// ---------------------------------------------------------------------------

model WeeklyDebtorSummaryDelivery {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  weekStart       DateTime  @map("week_start")
  status          String    @default("sending") // 'sending' | 'sent' | 'failed'
  resendMessageId String?   @map("resend_message_id")
  lastError       String?   @map("last_error")
  subject         String
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, weekStart])
  @@index([status, weekStart])
  @@map("weekly_debtor_summary_deliveries")
}

// ---------------------------------------------------------------------------
// AI Usage Logs (Small Business tier — ai_rewrite feature)
// ---------------------------------------------------------------------------

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  model            String // e.g. "gpt-4o-mini"
  feature          String // e.g. "ai_rewrite"
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  estimatedCostUsd Decimal  @map("estimated_cost_usd") @db.Decimal(12, 8)
  createdAt        DateTime @default(now()) @map("created_at")

  userProfile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Email Templates (Small Business tier)
// ---------------------------------------------------------------------------

model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String
  stage     Int // 1, 2, or 3
  subject   String
  htmlBody  String
  textBody  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userId], references: [userId])

  @@unique([userId, stage])
  @@map("email_templates")
}

// ---------------------------------------------------------------------------
// Accounting Connections (Xero / MYOB)
// ---------------------------------------------------------------------------

model AccountingConnection {
  id                    String    @id @default(cuid())
  userId                String
  provider              String // 'xero' | 'myob'
  organisationId        String    @map("organisation_id") // tenantId (Xero) or cf_uri constructed from businessId (MYOB, e.g. https://api.myob.com/accountright/{businessId})
  organisationName      String    @map("organisation_name")
  encryptedAccessToken  String    @map("encrypted_access_token")
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime  @map("token_expires_at")
  scopes                String // space-separated scope list as requested
  status                String    @default("active") // 'active' | 'disconnected' | 'revoked' | 'error'
  lastSyncedAt          DateTime? @map("last_synced_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  userProfile               UserProfile               @relation(fields: [userId], references: [userId])
  syncRuns                  AccountingSyncRun[]
  financialContacts         FinancialContact[]
  financialInvoices         FinancialInvoice[]
  financialPayments         FinancialPayment[]
  importedBills             ImportedBill[]
  importedBankTransactions  ImportedBankTransaction[]
  supplierProfiles          SupplierProfile[]
  spendInsights             SpendInsight[]
  cashForecastSnapshots     CashForecastSnapshot[]

  @@unique([userId, provider, organisationId])
  @@map("accounting_connections")
}

// ---------------------------------------------------------------------------
// Accounting Sync Runs
// ---------------------------------------------------------------------------

model AccountingSyncRun {
  id                     String    @id @default(cuid())
  accountingConnectionId String    @map("accounting_connection_id")
  provider               String // 'xero' | 'myob'
  userId                 String
  startedAt              DateTime  @default(now()) @map("started_at")
  completedAt            DateTime? @map("completed_at")
  status                 String    @default("running") // 'running' | 'success' | 'partial' | 'failed'
  invoicesCreated        Int       @default(0) @map("invoices_created")
  invoicesUpdated        Int       @default(0) @map("invoices_updated")
  invoicesSkipped        Int       @default(0) @map("invoices_skipped")
  errorMessage           String?   @map("error_message") // sanitised, no PII or tokens

  accountingConnection AccountingConnection @relation(fields: [accountingConnectionId], references: [id])

  @@index([accountingConnectionId, startedAt])
  @@index([userId, startedAt])
  @@map("accounting_sync_runs")
}

// ---------------------------------------------------------------------------
// OAuth States (CSRF nonce for accounting OAuth callbacks)
// ---------------------------------------------------------------------------

model OauthState {
  id        String   @id @default(cuid())
  userId    String
  provider  String // 'xero' | 'myob'
  nonce     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([nonce])
  @@index([expiresAt])
  @@map("oauth_states")
}

// ---------------------------------------------------------------------------
// SpendLeak Foundation Read Models
// ---------------------------------------------------------------------------

model ImportedBill {
  id                     String    @id @default(cuid())
  userId                 String    @map("user_id")
  accountingConnectionId String    @map("accounting_connection_id")
  sourceId               String    @map("source_id") // provider bill ID
  sourceContactId        String?   @map("source_contact_id")
  supplierName           String    @map("supplier_name")
  supplierReference      String?   @map("supplier_reference")
  documentNumber         String?   @map("document_number")
  expenseAccountCode     String?   @map("expense_account_code")
  expenseAccountName     String?   @map("expense_account_name")
  amountCents            Int       @map("amount_cents")
  gstCents               Int?      @map("gst_cents")
  currency               String // no default — always from source (design D3)
  dueDate                DateTime? @map("due_date")
  paidDate               DateTime? @map("paid_date")
  status                 String    @default("open")
  sourceUpdatedAt        DateTime? @map("source_updated_at")
  syncedAt               DateTime  @default(now()) @map("synced_at")
  rawSourceData          Json?     @map("raw_source_data")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  userProfile          UserProfile          @relation(fields: [userId], references: [userId])
  accountingConnection AccountingConnection @relation(fields: [accountingConnectionId], references: [id])

  @@unique([accountingConnectionId, sourceId])
  @@index([userId, status, dueDate])
  @@index([userId, supplierName])
  @@map("imported_bills")
}

