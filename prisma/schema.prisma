  name                         String
  supplierName                 String?   @map("supplier_name")
  supplierId                   String?   @map("supplier_id")
  category                     String
  frequency                    String // one_off | weekly | fortnightly | monthly | quarterly | six_monthly | annual | custom
  typicalAmountCents           Int       @map("typical_amount_cents")
  currency                     String
  source                       String    @default("system_inferred")
  confidence                   String    @default("medium") // confirmed | high | medium | low
  confidenceScore              Float     @default(0) @map("confidence_score")
  status                       String    @default("pending") // pending | confirmed | ignored | not_a_commitment | converted
  evidence                     Json?
  evidenceFingerprint          String?   @map("evidence_fingerprint")
  rejectionEvidenceFingerprint String?   @map("rejection_evidence_fingerprint")
  firstDetectedAt              DateTime  @default(now()) @map("first_detected_at")
  lastDetectedAt               DateTime  @default(now()) @map("last_detected_at")
  nextSuggestedAt              DateTime? @map("next_suggested_at")
  reviewNote                   String?   @map("review_note")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  userProfile UserProfile @relation(fields: [userId], references: [userId])
  events      CommitmentEvent[]

  @@index([userId, status, lastDetectedAt])
  @@index([userId, source])
  @@index([userId, supplierId])
  @@map("commitment_detection_candidates")
}

model CommitmentEvent {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  commitmentId         String?   @map("commitment_id")
  detectionCandidateId String?   @map("detection_candidate_id")
  eventType            String    @map("event_type")
  severity             String    @default("info")
  dedupeKey            String?   @map("dedupe_key")
  title                String
  message              String
  actorId              String?   @map("actor_id")
  metadata             Json?
  occurredAt           DateTime  @default(now()) @map("occurred_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  userProfile         UserProfile                   @relation(fields: [userId], references: [userId])
  commitment         Commitment?                   @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  detectionCandidate CommitmentDetectionCandidate? @relation(fields: [detectionCandidateId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, occurredAt])
  @@index([commitmentId, occurredAt])
  @@index([detectionCandidateId, occurredAt])
  @@map("commitment_events")
}

// ---------------------------------------------------------------------------
// Owner's Digest Foundation
// ---------------------------------------------------------------------------

model OwnersDigestSetting {
  id                     String   @id @default(cuid())
  userId                 String   @map("user_id")
  enabled                Boolean  @default(false)
  emailEnabled           Boolean  @default(false) @map("email_enabled")
  frequency              String   @default("weekly")
  deliveryDay            String   @default("monday") @map("delivery_day")
  deliveryTime           String   @default("07:00") @map("delivery_time")
  timezone               String   @default("Australia/Sydney")
  includeNeedsAttention  Boolean  @default(true) @map("include_needs_attention")
  includeOpportunities   Boolean  @default(true) @map("include_opportunities")
  includePositiveChanges Boolean  @default(true) @map("include_positive_changes")
  includeKeyNumbers      Boolean  @default(true) @map("include_key_numbers")
  maxActionItems         Int      @default(5) @map("max_action_items")
  minimumMaterialityCents Int     @default(10000) @map("minimum_materiality_cents")
  sendWhenEmpty          Boolean  @default(true) @map("send_when_empty")
  recipientScope         String   @default("owner_only") @map("recipient_scope")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  userProfile UserProfile @relation(fields: [userId], references: [userId])

  @@unique([userId])
  @@map("owners_digest_settings")
}

model OwnersDigestSnapshot {
  id                      String    @id @default(cuid())
  userId                  String    @map("user_id")
  frequency               String
  periodLabel             String?   @map("period_label")
  periodStart             DateTime  @map("period_start")
  periodEnd               DateTime  @map("period_end")
  status                  String
  summary                 String
  summaryMode             String    @default("deterministic") @map("summary_mode")
  dataAsOf                DateTime? @map("data_as_of")
  generatedAt             DateTime  @default(now()) @map("generated_at")
  lastRegeneratedAt       DateTime? @map("last_regenerated_at")
  generationSource        String    @default("scheduled") @map("generation_source")
  generationState         String    @default("complete") @map("generation_state")
  providerSuccessCount    Int       @default(0) @map("provider_success_count")
  providerFailureCount    Int       @default(0) @map("provider_failure_count")
  providerStaleCount      Int       @default(0) @map("provider_stale_count")
  topAttentionCount       Int       @default(0) @map("top_attention_count")
  opportunityCount        Int       @default(0) @map("opportunity_count")
  positiveCount           Int       @default(0) @map("positive_count")
  infoCount               Int       @default(0) @map("info_count")
  completenessStatus      String    @default("complete") @map("completeness_status")
  completenessSummary     String?   @map("completeness_summary")
  statusReason            String?   @map("status_reason")
  metadata                Json?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  userProfile   UserProfile              @relation(fields: [userId], references: [userId])
  items         OwnersDigestItem[]
  metrics       OwnersDigestMetric[]
  providerRuns  OwnersDigestProviderRun[]
  deliveries    OwnersDigestDelivery[]

  @@unique([userId, frequency, periodStart, periodEnd])
  @@index([userId, generatedAt])
  @@index([userId, status, generatedAt])
  @@map("owners_digest_snapshots")
}

model OwnersDigestItem {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  snapshotId            String   @map("snapshot_id")
  source                String
  signalType            String   @map("signal_type")
  severity              String
  priorityScore         Int      @default(0) @map("priority_score")
  section               String
  sortOrder             Int      @default(0) @map("sort_order")
  title                 String
  summary               String
  whyItMatters          String?  @map("why_it_matters")
  financialImpactCents  Int?     @map("financial_impact_cents")
  currentValue          Float?   @map("current_value")
  previousValue         Float?   @map("previous_value")
  changeValue           Float?   @map("change_value")
  changePercent         Float?   @map("change_percent")
  entityType            String?  @map("entity_type")
  entityId              String?  @map("entity_id")
  entityName            String?  @map("entity_name")
  recommendedAction     String?  @map("recommended_action")
  actionUrl             String?  @map("action_url")
  contributingSources   Json?    @map("contributing_sources")
  metadata              Json?
  detectedAt            DateTime @map("detected_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  userProfile UserProfile          @relation(fields: [userId], references: [userId])
  snapshot    OwnersDigestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, section, sortOrder])
  @@index([userId, source, severity])
  @@index([snapshotId, priorityScore])
  @@map("owners_digest_items")
}

model OwnersDigestMetric {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  snapshotId      String   @map("snapshot_id")
  metricKey       String   @map("metric_key")
  label           String
  section         String?  
  unit            String
  displayValue    String   @map("display_value")
  numericValue    Float?   @map("numeric_value")
  monetaryValueCents Int?  @map("monetary_value_cents")
  previousNumericValue Float? @map("previous_numeric_value")
  previousMonetaryValueCents Int? @map("previous_monetary_value_cents")
  changeNumericValue Float? @map("change_numeric_value")
  changeMonetaryValueCents Int? @map("change_monetary_value_cents")
  changePercent   Float?   @map("change_percent")
  sortOrder       Int      @default(0) @map("sort_order")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  userProfile UserProfile          @relation(fields: [userId], references: [userId])
  snapshot    OwnersDigestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, metricKey])
  @@index([userId, metricKey])
  @@index([snapshotId, sortOrder])
  @@map("owners_digest_metrics")
}

model OwnersDigestProviderRun {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  snapshotId         String    @map("snapshot_id")
  source             String
  status             String
  signalCount        Int       @default(0) @map("signal_count")
  surfacedCount      Int       @default(0) @map("surfaced_count")
  stale              Boolean   @default(false)
  entitled           Boolean   @default(true)
  configured         Boolean   @default(true)
  available          Boolean   @default(true)
  dataAsOf           DateTime? @map("data_as_of")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  durationMs         Int?      @map("duration_ms")
  errorCode          String?   @map("error_code")
  errorSummary       String?   @map("error_summary")
  metadata           Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  userProfile UserProfile          @relation(fields: [userId], references: [userId])
  snapshot    OwnersDigestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, source])
  @@index([userId, source, status])
  @@map("owners_digest_provider_runs")
}

model OwnersDigestDelivery {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  snapshotId       String    @map("snapshot_id")
  deliveryScope    String    @map("delivery_scope")
  channel          String    @default("email")
  status           String    @default("pending")
  recipientCount   Int       @default(0) @map("recipient_count")
  deliveryKey      String    @map("delivery_key")
  messageId        String?   @map("message_id")
  requestedAt      DateTime  @default(now()) @map("requested_at")
  sentAt           DateTime? @map("sent_at")
  failedAt         DateTime? @map("failed_at")
  errorCode        String?   @map("error_code")
  errorSummary     String?   @map("error_summary")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  userProfile UserProfile          @relation(fields: [userId], references: [userId])
  snapshot    OwnersDigestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([userId, deliveryKey])
  @@index([snapshotId, status])
  @@index([userId, status, requestedAt])
  @@map("owners_digest_deliveries")
}

// ---------------------------------------------------------------------------
// Scheduled Job Orchestration (Railway Celery — dispatcher claims + status)
// Internal orchestration tables: no end-user-facing route reads/writes these.
// Written exclusively by the Railway Celery worker (trusted/admin DB role,
// same RLS-bypass posture as prismaAdmin) — see
// openspec/changes/migrate-scheduled-jobs-to-railway-celery/design.md.
// ---------------------------------------------------------------------------

model ScheduledTaskClaim {
  id           String    @id @default(cuid())
  workflow     String // 'reminder_email' | 'accounting_sync' | 'promise_followup' | 'arrangement_lifecycle' | 'debtor_summary' | 'integration_retry' | 'reconciliation'
  claimKey     String    @unique @map("claim_key") // e.g. "{entityId}:{stage}:{scheduledDate}" — enforces idempotent claiming at the DB level
  entityId     String    @map("entity_id") // e.g. trackedInvoiceId / accountingConnectionId
  userId       String?   @map("user_id") // owning tenant, when the workflow is tenant-scoped
  status       String    @default("queued") // 'queued' | 'started' | 'processing' | 'sent' | 'failed' | 'retrying'
  attempts     Int       @default(0)
  lastError    String?   @map("last_error") // sanitised, no PII
  scheduledFor DateTime  @map("scheduled_for")
  claimedAt    DateTime? @map("claimed_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@index([workflow, status])
  @@map("scheduled_task_claims")
}

model DispatcherHeartbeat {
  id         String   @id @default(cuid())
  dispatcher String   @unique // identity of the Celery Beat instance, e.g. "celery-beat"
  lastRunAt  DateTime @map("last_run_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("dispatcher_heartbeats")
}

// ---------------------------------------------------------------------------
// Platform Admin Models
// ---------------------------------------------------------------------------

enum PlatformRoleType {
  platform_owner
  platform_admin
  platform_support
}

enum PlatformRoleStatus {
  active
  disabled
}

enum AdminDeviceStatus {
  pending
  active
  revoked
  expired
}

enum AdminAuditAction {
  admin_challenge_created
  admin_challenge_verified
  admin_challenge_failed
  admin_session_started
  admin_session_expired
  admin_session_revoked
  device_enrolled
  device_revoked
  staff_invited
  role_assigned
  role_changed
  staff_disabled
  tenant_viewed
  impersonation_started
  impersonation_ended
  impersonation_destructive_action
  subscription_changed
  integration_action
  email_job_retried
  email_job_paused
  email_job_resumed
  system_setting_changed
  admin_tenant_action
  customer_search
  impersonate_start
  impersonate_end
  impersonate_timeout
  impersonate_conflict
  update_schedule
  pause_invoices
  resume_invoices
  trigger_email
  mark_invoice_paid
  training_content_created
  training_content_updated
  training_submitted_for_review
  training_published
  training_restored
}

enum StaffInvitationStatus {
  pending
  accepted
  expired
  revoked
}

model PlatformRole {
  id        String             @id @default(cuid())
  userId    String             @unique @map("user_id")
  role      PlatformRoleType
  status    PlatformRoleStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at")
  createdBy String             @map("created_by")
  updatedAt DateTime           @updatedAt @map("updated_at")

  adminDevices    AdminDevice[]
  adminSessions   AdminSession[]
  adminChallenges AdminChallenge[]

  @@map("platform_roles")
}

model AdminDevice {
  id                   String            @id @default(cuid())
  adminUserId          String            @map("admin_user_id")
  label                String
  publicKeyBytes       Bytes             @map("public_key_bytes")
  publicKeyFingerprint String            @unique @map("public_key_fingerprint")
  keyType              String            @default("ssh-ed25519") @map("key_type")
  status               AdminDeviceStatus @default(pending)
  createdAt            DateTime          @default(now()) @map("created_at")
  createdBy            String            @map("created_by")
  revokedAt            DateTime?         @map("revoked_at")
  revokedBy            String?           @map("revoked_by")
  lastVerifiedAt       DateTime?         @map("last_verified_at")
  lastUsedIp           String?           @map("last_used_ip")
  lastUserAgent        String?           @map("last_user_agent")

  platformRole  PlatformRole   @relation(fields: [adminUserId], references: [userId])
  adminSessions AdminSession[]

  @@index([adminUserId])
  @@map("admin_devices")
}

model AdminChallenge {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  nonce     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  ipAddress String    @map("ip_address")
  userAgent String    @map("user_agent")

  adminSession AdminSession?
  platformRole PlatformRole  @relation(fields: [userId], references: [userId])

  @@index([userId, createdAt])
  @@map("admin_challenges")
}

model AdminSession {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  adminDeviceId        String    @map("admin_device_id")
  adminChallengeId     String    @unique @map("admin_challenge_id")
  sessionToken         String    @unique @map("session_token")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  impersonatedTenantId String?   @map("impersonated_tenant_id")
  impersonatedUserId   String?   @map("impersonated_user_id") // customer being impersonated (support console)
  notifyCustomer       Boolean   @default(false) @map("notify_customer") // whether to notify customer after impersonation
  createdAt            DateTime  @default(now()) @map("created_at")
  startedAt            DateTime  @default(now()) @map("started_at") // when support session started
  endedAt              DateTime? @map("ended_at") // when support session ended
  duration             Int?      @map("duration") // seconds (calculated on end)
  actionCount          Int       @default(0) @map("action_count") // count of linked audit events
  ipAddress            String    @map("ip_address")
  userAgent            String    @map("user_agent")

  platformRole     PlatformRole      @relation(fields: [userId], references: [userId])
  adminDevice      AdminDevice       @relation(fields: [adminDeviceId], references: [id])
  adminChallenge   AdminChallenge    @relation(fields: [adminChallengeId], references: [id])
  adminAuditEvents AdminAuditEvent[] // link to audit events created during this session

  @@index([userId, expiresAt])
  @@index([impersonatedUserId, startedAt])
  @@map("admin_sessions")
}

model AdminAuditEvent {
  id                     String           @id @default(cuid())
  actorUserId            String           @map("actor_user_id")
  actorEmail             String           @map("actor_email")
  platformRole           PlatformRoleType @map("platform_role")
  adminDeviceId          String?          @map("admin_device_id")
  adminDeviceFingerprint String?          @map("admin_device_fingerprint")
  adminSessionId         String?          @map("admin_session_id") // link to impersonation session if event occurred during one
  action                 AdminAuditAction
  targetType             String?          @map("target_type")
  targetId               String?          @map("target_id")
  targetUserId           String?          @map("target_user_id") // customer being acted upon (support console)
  resourceId             String?          @map("resource_id") // specific resource (invoiceId, scheduleId, etc.)
  tenantId               String?          @map("tenant_id")
  ipAddress              String           @map("ip_address")
  userAgent              String           @map("user_agent")
  requestId              String           @map("request_id")
  success                Boolean
  reason                 String?
  metadata               Json?
  details                Json? // context-specific data (old/new values, counts, etc.)
  createdAt              DateTime         @default(now()) @map("created_at")

  adminSession AdminSession? @relation(fields: [adminSessionId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([tenantId, createdAt])
  @@index([adminSessionId])
  @@index([targetUserId, createdAt])
  @@map("admin_audit_events")
}

model StaffInvitation {
  id               String                @id @default(cuid())
  email            String
  role             PlatformRoleType
  token            String                @unique
  status           StaffInvitationStatus @default(pending)
  createdAt        DateTime              @default(now()) @map("created_at")
  createdBy        String                @map("created_by")
  expiresAt        DateTime              @map("expires_at")
  acceptedAt       DateTime?             @map("accepted_at")
  acceptedByUserId String?               @map("accepted_by_user_id")

  @@index([token])
  @@index([email, status])
  @@map("staff_invitations")
}

// ---------------------------------------------------------------------------
// Audit Log Retention (Archival tracking for 7-year compliance)
// ---------------------------------------------------------------------------

model AuditRetentionLog {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  recordsArchived Int      @map("records_archived")
  s3Path          String?  @map("s3_path")
  success         Boolean  @default(true)
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([timestamp])
  @@index([success])
  @@map("audit_retention_logs")
}

enum TrainingLifecycleState {
  draft
  review
  published
}

enum TrainingAudience {
  public
  signed_in
}

enum TrainingDestinationValidationStatus {
  pending
  valid
  invalid
  deprecated
}

model TrainingContent {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  title           String
  summary         String?
  content         Json
  lifecycleState  TrainingLifecycleState @default(draft) @map("lifecycle_state")
  audience        TrainingAudience       @default(signed_in)
  featureKey      String?                @map("feature_key")
  routeHint       String?                @map("route_hint")
  destinationKeys Json?                  @map("destination_keys")
  publishedAt     DateTime?              @map("published_at")
  createdBy       String                 @map("created_by")
  updatedBy       String                 @map("updated_by")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  revisions         TrainingRevision[]
  destinationUsages TrainingDestinationUsage[]

  @@index([lifecycleState, audience, publishedAt])
  @@map("training_content")
}

model TrainingRevision {
  id                     String                 @id @default(cuid())
  trainingContentId      String                 @map("training_content_id")
  revisionNumber         Int                    @map("revision_number")
  snapshot               Json
  snapshotState          TrainingLifecycleState @map("snapshot_state")
  changeNote             String?                @map("change_note")
  actorUserId            String                 @map("actor_user_id")
  restoredFromRevisionId String?                @map("restored_from_revision_id")
  createdAt              DateTime               @default(now()) @map("created_at")

  trainingContent       TrainingContent    @relation(fields: [trainingContentId], references: [id], onDelete: Cascade)
  restoredFromRevision  TrainingRevision?  @relation("TrainingRevisionRestoreLineage", fields: [restoredFromRevisionId], references: [id])
  restoredIntoRevisions TrainingRevision[] @relation("TrainingRevisionRestoreLineage")

  @@unique([trainingContentId, revisionNumber])
  @@index([trainingContentId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("training_revisions")
}

model TrainingDestinationUsage {
  id                String                              @id @default(cuid())
  trainingContentId String                              @map("training_content_id")
  destinationKey    String                              @map("destination_key")
  validationStatus  TrainingDestinationValidationStatus @default(pending) @map("validation_status")
  lastValidatedAt   DateTime?                           @map("last_validated_at")
  validationDetails Json?                               @map("validation_details")
  createdAt         DateTime                            @default(now()) @map("created_at")
  updatedAt         DateTime                            @updatedAt @map("updated_at")

  trainingContent TrainingContent @relation(fields: [trainingContentId], references: [id], onDelete: Cascade)

  @@unique([trainingContentId, destinationKey])
  @@index([destinationKey, validationStatus])
  @@map("training_destination_usages")
}
