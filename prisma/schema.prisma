  mappings    SpendImportColumnMapping[]
  stagingRows SpendImportStagingRow[]
  errors      SpendImportError[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("spend_import_batches")
}

model SpendImportColumnMapping {
  id           String   @id @default(cuid())
  batchId      String   @map("batch_id")
