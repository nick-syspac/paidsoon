// ---------------------------------------------------------------------------
// SpendLeak Expense Import Models
// ---------------------------------------------------------------------------

model SpendImportBatch {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  fileName        String    @map("file_name")
  fileType        String    @map("file_type")
  fileSizeBytes   Int       @map("file_size_bytes")
  contentHash     String    @map("content_hash")
  schemaVersion   String    @map("schema_version")
  worksheetName   String?   @map("worksheet_name")
  defaultCurrency String?   @map("default_currency")
  duplicateMode   String    @default("update_existing") @map("duplicate_mode")
  mapping         Json?     @map("mapping")
  status          String    @default("uploaded")
  failureReason   String?   @map("failure_reason")
  rowsTotal       Int       @default(0) @map("rows_total")
  rowsValid       Int       @default(0) @map("rows_valid")
  rowsWarning     Int       @default(0) @map("rows_warning")
  rowsSkipped     Int       @default(0) @map("rows_skipped")
  rowsFailed      Int       @default(0) @map("rows_failed")
  createdAt       DateTime  @default(now()) @map("created_at")
  validatedAt     DateTime? @map("validated_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  userProfile UserProfile                @relation(fields: [userId], references: [userId])
  mappings    SpendImportColumnMapping[]
  stagingRows SpendImportStagingRow[]
  errors      SpendImportError[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("spend_import_batches")
}

model SpendImportColumnMapping {
  id           String   @id @default(cuid())
  batchId      String   @map("batch_id")
  sourceColumn String   @map("source_column")
  targetField  String   @map("target_field")
  suggested    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  batch SpendImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, sourceColumn])
  @@index([batchId, targetField])
  @@map("spend_import_column_mappings")
}

model SpendImportStagingRow {
  id               String   @id @default(cuid())
  batchId          String   @map("batch_id")
  rowNumber        Int      @map("row_number")
  raw              Json
  normalized       Json?
  status           String   @default("pending")
  validationErrors Json?    @map("validation_errors")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  batch SpendImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@index([batchId, rowNumber])
  @@map("spend_import_staging_rows")
}

model SpendImportError {
  id          String   @id @default(cuid())
  batchId     String   @map("batch_id")
  rowNumber   Int?     @map("row_number")
  fieldName   String?  @map("field_name")
  errorCode   String   @map("error_code")
  message     String
  severity    String   @default("error")
  createdAt   DateTime @default(now()) @map("created_at")

  batch SpendImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, severity])
  @@index([batchId, errorCode])
  @@map("spend_import_errors")
}

model CashForecastSnapshot {
  id                     String   @id @default(cuid())
  userId                 String   @map("user_id")
  accountingConnectionId String?  @map("accounting_connection_id")
  currentCashCents       Int      @map("current_cash_cents")
  receivablesCents       Int      @default(0) @map("receivables_cents")
  payablesCents          Int      @default(0) @map("payables_cents")
  predictedMonthEndCents Int?     @map("predicted_month_end_cents")
  runwayDays             Int?     @map("runway_days")
  assumptions            Json?    @map("assumptions")
  snapshotAt             DateTime @default(now()) @map("snapshot_at")
  createdAt              DateTime @default(now()) @map("created_at")

  userProfile          UserProfile           @relation(fields: [userId], references: [userId])
  accountingConnection AccountingConnection? @relation(fields: [accountingConnectionId], references: [id])

  @@index([userId, snapshotAt])
  @@map("cash_forecast_snapshots")
}

// ---------------------------------------------------------------------------
// Scheduled Job Orchestration (Railway Celery — dispatcher claims + status)
// Internal orchestration tables: no end-user-facing route reads/writes these.
// Written exclusively by the Railway Celery worker (trusted/admin DB role,
// same RLS-bypass posture as prismaAdmin) — see
// openspec/changes/migrate-scheduled-jobs-to-railway-celery/design.md.
// ---------------------------------------------------------------------------

model ScheduledTaskClaim {
  id           String    @id @default(cuid())
  workflow     String // 'reminder_email' | 'accounting_sync' | 'promise_followup' | 'arrangement_lifecycle' | 'debtor_summary' | 'integration_retry' | 'reconciliation'
  claimKey     String    @unique @map("claim_key") // e.g. "{entityId}:{stage}:{scheduledDate}" — enforces idempotent claiming at the DB level
  entityId     String    @map("entity_id") // e.g. trackedInvoiceId / accountingConnectionId
  userId       String?   @map("user_id") // owning tenant, when the workflow is tenant-scoped
  status       String    @default("queued") // 'queued' | 'started' | 'processing' | 'sent' | 'failed' | 'retrying'
  attempts     Int       @default(0)
  lastError    String?   @map("last_error") // sanitised, no PII
  scheduledFor DateTime  @map("scheduled_for")
  claimedAt    DateTime? @map("claimed_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@index([workflow, status])
  @@map("scheduled_task_claims")
}

model DispatcherHeartbeat {
  id         String   @id @default(cuid())
  dispatcher String   @unique // identity of the Celery Beat instance, e.g. "celery-beat"
  lastRunAt  DateTime @map("last_run_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("dispatcher_heartbeats")
}

// ---------------------------------------------------------------------------
// Platform Admin Models
// ---------------------------------------------------------------------------

enum PlatformRoleType {
  platform_owner
  platform_admin
  platform_support
}

enum PlatformRoleStatus {
  active
  disabled
}

enum AdminDeviceStatus {
  pending
  active
  revoked
  expired
}

enum AdminAuditAction {
  admin_challenge_created
  admin_challenge_verified
  admin_challenge_failed
  admin_session_started
  admin_session_expired
  admin_session_revoked
  device_enrolled
  device_revoked
  staff_invited
  role_assigned
  role_changed
  staff_disabled
  tenant_viewed
  impersonation_started
  impersonation_ended
  impersonation_destructive_action
  subscription_changed
  integration_action
  email_job_retried
  email_job_paused
  email_job_resumed
  system_setting_changed
  admin_tenant_action
  customer_search
  impersonate_start
  impersonate_end
  impersonate_timeout
  impersonate_conflict
  update_schedule
  pause_invoices
  resume_invoices
  trigger_email
  mark_invoice_paid
  training_content_created
  training_content_updated
  training_submitted_for_review
  training_published
  training_restored
}

enum StaffInvitationStatus {
  pending
  accepted
  expired
  revoked
}

model PlatformRole {
  id        String             @id @default(cuid())
  userId    String             @unique @map("user_id")
  role      PlatformRoleType
  status    PlatformRoleStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at")
  createdBy String             @map("created_by")
  updatedAt DateTime           @updatedAt @map("updated_at")

  adminDevices    AdminDevice[]
  adminSessions   AdminSession[]
  adminChallenges AdminChallenge[]

  @@map("platform_roles")
}

model AdminDevice {
  id                   String            @id @default(cuid())
  adminUserId          String            @map("admin_user_id")
  label                String
  publicKeyBytes       Bytes             @map("public_key_bytes")
  publicKeyFingerprint String            @unique @map("public_key_fingerprint")
  keyType              String            @default("ssh-ed25519") @map("key_type")
  status               AdminDeviceStatus @default(pending)
  createdAt            DateTime          @default(now()) @map("created_at")
  createdBy            String            @map("created_by")
  revokedAt            DateTime?         @map("revoked_at")
  revokedBy            String?           @map("revoked_by")
  lastVerifiedAt       DateTime?         @map("last_verified_at")
  lastUsedIp           String?           @map("last_used_ip")
  lastUserAgent        String?           @map("last_user_agent")

  platformRole  PlatformRole   @relation(fields: [adminUserId], references: [userId])
  adminSessions AdminSession[]

  @@index([adminUserId])
  @@map("admin_devices")
}

model AdminChallenge {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  nonce     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  ipAddress String    @map("ip_address")
  userAgent String    @map("user_agent")

  adminSession AdminSession?
  platformRole PlatformRole  @relation(fields: [userId], references: [userId])

  @@index([userId, createdAt])
  @@map("admin_challenges")
}

model AdminSession {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  adminDeviceId        String    @map("admin_device_id")
  adminChallengeId     String    @unique @map("admin_challenge_id")
  sessionToken         String    @unique @map("session_token")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  impersonatedTenantId String?   @map("impersonated_tenant_id")
  impersonatedUserId   String?   @map("impersonated_user_id") // customer being impersonated (support console)
  notifyCustomer       Boolean   @default(false) @map("notify_customer") // whether to notify customer after impersonation
  createdAt            DateTime  @default(now()) @map("created_at")
  startedAt            DateTime  @default(now()) @map("started_at") // when support session started
  endedAt              DateTime? @map("ended_at") // when support session ended
  duration             Int?      @map("duration") // seconds (calculated on end)
  actionCount          Int       @default(0) @map("action_count") // count of linked audit events
  ipAddress            String    @map("ip_address")
  userAgent            String    @map("user_agent")

  platformRole     PlatformRole      @relation(fields: [userId], references: [userId])
  adminDevice      AdminDevice       @relation(fields: [adminDeviceId], references: [id])
  adminChallenge   AdminChallenge    @relation(fields: [adminChallengeId], references: [id])
  adminAuditEvents AdminAuditEvent[] // link to audit events created during this session

  @@index([userId, expiresAt])
  @@index([impersonatedUserId, startedAt])
  @@map("admin_sessions")
}

model AdminAuditEvent {
  id                     String           @id @default(cuid())
  actorUserId            String           @map("actor_user_id")
  actorEmail             String           @map("actor_email")
  platformRole           PlatformRoleType @map("platform_role")
  adminDeviceId          String?          @map("admin_device_id")
  adminDeviceFingerprint String?          @map("admin_device_fingerprint")
  adminSessionId         String?          @map("admin_session_id") // link to impersonation session if event occurred during one
  action                 AdminAuditAction
  targetType             String?          @map("target_type")
  targetId               String?          @map("target_id")
  targetUserId           String?          @map("target_user_id") // customer being acted upon (support console)
  resourceId             String?          @map("resource_id") // specific resource (invoiceId, scheduleId, etc.)
  tenantId               String?          @map("tenant_id")
  ipAddress              String           @map("ip_address")
  userAgent              String           @map("user_agent")
  requestId              String           @map("request_id")
  success                Boolean
  reason                 String?
  metadata               Json?
  details                Json? // context-specific data (old/new values, counts, etc.)
  createdAt              DateTime         @default(now()) @map("created_at")

  adminSession AdminSession? @relation(fields: [adminSessionId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([tenantId, createdAt])
  @@index([adminSessionId])
  @@index([targetUserId, createdAt])
  @@map("admin_audit_events")
}

model StaffInvitation {
  id               String                @id @default(cuid())
  email            String
  role             PlatformRoleType
  token            String                @unique
  status           StaffInvitationStatus @default(pending)
  createdAt        DateTime              @default(now()) @map("created_at")
  createdBy        String                @map("created_by")
  expiresAt        DateTime              @map("expires_at")
  acceptedAt       DateTime?             @map("accepted_at")
  acceptedByUserId String?               @map("accepted_by_user_id")

  @@index([token])
  @@index([email, status])
  @@map("staff_invitations")
}

// ---------------------------------------------------------------------------
// Audit Log Retention (Archival tracking for 7-year compliance)
// ---------------------------------------------------------------------------

model AuditRetentionLog {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  recordsArchived Int      @map("records_archived")
  s3Path          String?  @map("s3_path")
  success         Boolean  @default(true)
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([timestamp])
  @@index([success])
  @@map("audit_retention_logs")
}

enum TrainingLifecycleState {
  draft
  review
  published
}

enum TrainingAudience {
  public
  signed_in
}

enum TrainingDestinationValidationStatus {
  pending
  valid
  invalid
  deprecated
}

model TrainingContent {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  title           String
  summary         String?
  content         Json
  lifecycleState  TrainingLifecycleState @default(draft) @map("lifecycle_state")
  audience        TrainingAudience       @default(signed_in)
  featureKey      String?                @map("feature_key")
  routeHint       String?                @map("route_hint")
  destinationKeys Json?                  @map("destination_keys")
  publishedAt     DateTime?              @map("published_at")
  createdBy       String                 @map("created_by")
  updatedBy       String                 @map("updated_by")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  revisions         TrainingRevision[]
  destinationUsages TrainingDestinationUsage[]

  @@index([lifecycleState, audience, publishedAt])
  @@map("training_content")
}

model TrainingRevision {
  id                     String                 @id @default(cuid())
  trainingContentId      String                 @map("training_content_id")
  revisionNumber         Int                    @map("revision_number")
  snapshot               Json
  snapshotState          TrainingLifecycleState @map("snapshot_state")
  changeNote             String?                @map("change_note")
  actorUserId            String                 @map("actor_user_id")
  restoredFromRevisionId String?                @map("restored_from_revision_id")
  createdAt              DateTime               @default(now()) @map("created_at")

  trainingContent       TrainingContent    @relation(fields: [trainingContentId], references: [id], onDelete: Cascade)
  restoredFromRevision  TrainingRevision?  @relation("TrainingRevisionRestoreLineage", fields: [restoredFromRevisionId], references: [id])
  restoredIntoRevisions TrainingRevision[] @relation("TrainingRevisionRestoreLineage")

  @@unique([trainingContentId, revisionNumber])
  @@index([trainingContentId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("training_revisions")
}

model TrainingDestinationUsage {
  id                String                              @id @default(cuid())
  trainingContentId String                              @map("training_content_id")
  destinationKey    String                              @map("destination_key")
  validationStatus  TrainingDestinationValidationStatus @default(pending) @map("validation_status")
  lastValidatedAt   DateTime?                           @map("last_validated_at")
  validationDetails Json?                               @map("validation_details")
  createdAt         DateTime                            @default(now()) @map("created_at")
  updatedAt         DateTime                            @updatedAt @map("updated_at")

  trainingContent TrainingContent @relation(fields: [trainingContentId], references: [id], onDelete: Cascade)

  @@unique([trainingContentId, destinationKey])
  @@index([destinationKey, validationStatus])
  @@map("training_destination_usages")
}
