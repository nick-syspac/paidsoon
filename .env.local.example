# PaidSoon — Local development environment example
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it contains real secrets.
#
# This file targets the LOCAL environment:
#   - Supabase project: paidsoon-dev
#   - Stripe mode:      test (sk_test_...)
#   - Email sender:     onboarding@resend.dev (Resend sandbox)
#   - Cron:             not scheduled — trigger manually with curl
#
# See docs/environment-promotion.md for the full environment model.
# See docs/runbooks/README.md for the canonical env-var matrix.

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Company ABN shown in the marketing footer (optional — falls back to placeholder)
# NEXT_PUBLIC_COMPANY_ABN=12 345 678 901

# Launch gate — false keeps sign-in/sign-up disabled (pre-launch posture)
LIVE=false

# Server-only diagnostic tracing. Keep false unless actively troubleshooting.
# Do not expose this as NEXT_PUBLIC_DEBUG.
DEBUG=false

# ─── Supabase (paidsoon-dev project) ──────────────────────────────────────────
# Copy the project ref and keys from the paidsoon-dev Supabase dashboard.
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_DB_PASSWORD=replace-with-dev-database-password
# SUPABASE_DB_POOLER_HOST=aws-1-ap-southeast-2.pooler.supabase.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only secret — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ─── Vercel Cron ──────────────────────────────────────────────────────────────
# Optional locally — only needed if you use the manual curl trigger.
# Generate: openssl rand -hex 32
CRON_SECRET=replace-with-openssl-rand-hex-32-output

# ─── Stripe (test mode) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SOLO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SMALL_BUSINESS_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxx

# Local: obtain from Stripe CLI — run: stripe listen --forward-to localhost:3000/api/webhooks/stripe-billing
STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=PaidSoon (dev)

# AI keys — optional, only needed if you use AI features in dev.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ─── Seed scripts only ────────────────────────────────────────────────────────
# Used by scripts/seed-preview.ts and scripts/db-reset-local.ts.
# NEVER set to "production" or "prod". NEVER set this in Vercel production env.
SEED_ENV=local
