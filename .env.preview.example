# PaidSoon — Vercel Preview environment example
# These variables are set in Vercel Dashboard → Settings → Environment Variables
# for the "Preview" environment target (all non-production branch deployments).
#
# This file documents the expected shape. Do NOT commit real values.
# Production variables must ONLY live in Vercel secrets, not in committed files.
#
# This file targets the PREVIEW environment:
#   - Supabase project: paidsoon-dev  (same project as Local)
#   - Stripe mode:      test (sk_test_...)
#   - Email sender:     onboarding@resend.dev (Resend sandbox)
#   - Cron:             NOT scheduled on preview — Vercel only runs cron on Production
#   - Webhooks:         NOT registered — no webhook endpoint for preview
#
# See docs/environment-promotion.md for the full environment model.
# See docs/runbooks/README.md for the canonical env-var matrix.
# See docs/runbooks/vercel.md §2 for the Vercel configuration steps.

# ─── App ──────────────────────────────────────────────────────────────────────
# Use a stable preview alias, or leave blank (relies on VERCEL_URL system var).
# OAuth redirect URIs must match this value — set a stable alias in Vercel Settings → Domains.
NEXT_PUBLIC_APP_URL=https://paidsoon-preview.vercel.app

LIVE=false

# Server-only diagnostic tracing. Keep false by default; enable only for targeted preview diagnostics.
# Do not expose this as NEXT_PUBLIC_DEBUG.
DEBUG=false

# ─── Supabase (paidsoon-dev project — shared with Local) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgresql://postgres.your-dev-ref:DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:DB_PASSWORD@db.your-dev-ref.supabase.co:5432/postgres

# ─── Vercel Cron ──────────────────────────────────────────────────────────────
# CRON_SECRET is not required for Preview — cron does not fire on preview deployments.
# You may set it anyway to enable the manual curl trigger for email testing.
# CRON_SECRET=

# ─── Stripe (test mode) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SOLO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SMALL_BUSINESS_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxx

# Webhook secrets are NOT set on Preview — no webhook endpoint is registered for preview.
# STRIPE_BILLING_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET=

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=PaidSoon (preview)

# ─── Seed scripts ─────────────────────────────────────────────────────────────
# SEED_ENV must NOT be set as a persistent Vercel environment variable.
# It is passed inline when running seed scripts from your local machine:
#   npm run seed:preview   (sets SEED_ENV=preview at invocation time)
