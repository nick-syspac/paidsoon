# PaidSoon — Vercel Production environment example
# These variables are set in Vercel Dashboard → Settings → Environment Variables
# for the "Production" environment target only.
#
# This file documents the expected shape. Do NOT commit real values here.
# Production credentials must ONLY live in Vercel project secrets.
#
# This file targets the PRODUCTION environment:
#   - Supabase project: paidsoon-prod  (dedicated production project)
#   - Stripe mode:      live (sk_live_...)
#   - Email sender:     billing@paidsoon.com (verified Resend domain)
#   - Cron:             daily at 09:00 UTC via vercel.json
#   - Webhooks:         both billing and connect endpoints registered
#
# WARNING: Never point these values at paidsoon-dev. Production must always
# use paidsoon-prod. Mixing them allows preview code to read/write real data.
#
# See docs/environment-promotion.md for the full environment model.
# See docs/runbooks/README.md for the canonical env-var matrix.
# See docs/runbooks/vercel.md §2 for the Vercel configuration steps.

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://paidsoon.com
LIVE=true

# Server-only diagnostic tracing. Keep false in production except for approved, time-boxed diagnostics.
# Do not expose this as NEXT_PUBLIC_DEBUG.
DEBUG=false

# ─── Supabase (paidsoon-prod project) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only secret — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

DATABASE_URL=postgresql://postgres.your-prod-ref:DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:DB_PASSWORD@db.your-prod-ref.supabase.co:5432/postgres

# ─── Vercel Cron ──────────────────────────────────────────────────────────────
# Required. Generate: openssl rand -hex 32
CRON_SECRET=replace-with-openssl-rand-hex-32-output

# ─── Stripe (live mode) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SOLO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SMALL_BUSINESS_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxx

# Live-mode webhook secrets — obtained from Stripe Dashboard after registering endpoints
STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=billing@paidsoon.com
RESEND_FROM_NAME=PaidSoon

# ─── Seed scripts — NEVER set in production ───────────────────────────────────
# SEED_ENV must NEVER be set in production. The seed script will refuse to run
# if SEED_ENV is "production" or unset. Do not create this variable here.
# SEED_ENV=  ← DO NOT SET
