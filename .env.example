# PaidSoon — Environment Variable Reference
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file with real credentials.
# See docs/runbooks/README.md for per-environment value guidance.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# The Supabase project URL (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The Supabase publishable (anon) key (public — safe for browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# The Supabase secret key (server-only — never expose to browser)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Prisma runtime connection — pgBouncer pooled URL (non-owner role, RLS applies)
DATABASE_URL=postgresql://authenticator:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Prisma migrations only — direct (non-pooled) connection (owner role, bypasses RLS)
DIRECT_URL=postgresql://postgres:password@aws-0-region.supabase.com:5432/postgres

# ─── App ──────────────────────────────────────────────────────────────────────
# Full URL of the app (used for OAuth redirects and absolute links)
# Local: http://localhost:3000
# Production: https://paidsoon.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Launch gate — set to true to enable sign-in/sign-up pages
# false = pre-launch (auth pages disabled), true = live
LIVE=false

# ─── Vercel Cron ──────────────────────────────────────────────────────────────
# Secret token for authenticating cron job requests (Bearer token)
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-openssl-rand-hex-32-output

# ─── Stripe Billing ───────────────────────────────────────────────────────────
# Stripe API secret key — use sk_test_... for dev/preview, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs for each subscription tier (from Stripe dashboard)
STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SOLO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SMALL_BUSINESS_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# Legacy fallback Price ID for Solo tier (optional — only needed if migrating from old "pro" plan)
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# ─── Stripe Connect ───────────────────────────────────────────────────────────
# Stripe Connect OAuth client ID (from Stripe Connect settings)
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxx

# ─── Stripe Webhooks ──────────────────────────────────────────────────────────
# Webhook signing secrets — obtained from the Stripe dashboard for each registered endpoint
# Local dev: use the Stripe CLI (stripe listen) to get a whsec_... value
STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Resend API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# System "From" email address — must be a verified Resend sending domain
# Local/Preview: onboarding@resend.dev (Resend sandbox)
# Production: billing@paidsoon.com (verified domain)
RESEND_FROM_EMAIL=onboarding@resend.dev

# System "From" display name
RESEND_FROM_NAME=PaidSoon (dev)

# ─── Accounting Integrations ──────────────────────────────────────────────────
# AES-256 key for encrypting stored OAuth tokens (generate with: openssl rand -hex 32)
# Server-only — never expose to browser or commit to source control
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output

# Xero OAuth 2.0 app credentials (from https://developer.xero.com/app/manage)
# Server-only — never expose to browser
XERO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XERO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must match a registered redirect URI in the Xero developer portal
# Local: http://localhost:3000/api/integrations/xero/callback
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback

# MYOB OAuth 2.0 app credentials (from https://developer.myob.com)
# Server-only — never expose to browser
MYOB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MYOB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must match a registered redirect URI in the MYOB developer portal
# Local: http://localhost:3000/api/integrations/myob/callback
MYOB_REDIRECT_URI=http://localhost:3000/api/integrations/myob/callback
