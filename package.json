{
  "name": "paidsoon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 4001",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "SUPABASE_PROJECT_REF=abcdefghijklmnopqrst SUPABASE_DB_PASSWORD=test-only-password node --experimental-test-module-mocks --import tsx --test tests/**/*.test.ts",
    "prisma:generate": "PRISMA_GENERATE_ONLY=true prisma generate",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:apply-rls": "node --import tsx scripts/run-psql.ts prisma/rls-policies.sql",
    "verify:supabase-client": "node --import tsx scripts/verify-supabase-client-boundary.ts",
    "check:supabase-environment": "node --import tsx scripts/check-supabase-environment.ts",
    "verify-rls": "node --import tsx scripts/verify-rls.ts",
    "db:seed": "SEED_ENV=local node --import tsx scripts/seed-preview.ts",
    "db:seed:reset": "SEED_ENV=local SEED_RESET_ONLY=true node --import tsx scripts/seed-preview.ts",
    "seed:local": "SEED_ENV=local node --import tsx scripts/seed-preview.ts",
    "seed:preview": "SEED_ENV=preview node --import tsx scripts/seed-preview.ts",
    "verify-seed": "node --import tsx scripts/verify-seed.ts",
    "import:help-mdx": "node --import tsx scripts/import-help-mdx.ts --dry-run",
    "import:help-mdx:write": "node --import tsx scripts/import-help-mdx.ts --write",
    "verify:training-import": "node --import tsx scripts/verify-training-import.ts",
    "db:reset:local": "SEED_ENV=local node --import tsx scripts/db-reset-local.ts",
    "seed:admin-owner": "node --import tsx scripts/seed-admin-owner.ts",
    "get:admin-devices": "node --import tsx scripts/get-admin-devices.ts",
    "reset:myob-connection": "node --import tsx scripts/reset-myob-connection.ts",
    "backfill:chase-volume-limits": "node --import tsx scripts/backfill-chase-volume-limits.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.74",
    "@marsidev/react-turnstile": "^1.5.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/server": "^1.1.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.2",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/mdx": "^2.0.14",
    "@types/sanitize-html": "^2.16.1",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.14.0",
    "fumadocs-mdx": "^15.2.1",
    "lucide-react": "^1.16.0",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "sanitize-html": "^2.17.5",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0",
    "vercel": "^56.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
